{
  "name": "Civi for the City of Mableton",
  "short_name": "Civi",
  "description": "Report a problem to the City of Mableton. Civi sends it to the right department, and city staff reply in the app. A CivIQ product.",
  "id": "/",
  "start_url": "/#/resident",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F3EC",
